  "basePath": "/",
  "paths": {
    "/api/v1/projects/cost": {
      "get": {
        "description": "Выполняет полный расчёт стоимости размещённых средств защиты с группировкой\nпо эшелонам и типам.",
        "produces": [
          "application/json"
        ],
        "tags": [
          "api"
        ],
        "summary": "Рассчитать стоимость конфигурации проекта",
        "operationId": "calculateCost",
        "parameters": [
          {
            "type": "string",
            "x-go-name": "ProjectID",
            "description": "ID проекта (предпочтительный параметр).",
            "name": "projectId",
            "in": "query"
          },
          {
            "type": "string",
            "x-go-name": "ID",
            "description": "Совместимый alias projectId; конфликтующие значения отклоняются.",
            "name": "id",
            "in": "query"
          },
          {
            "minimum": 1,
            "type": "integer",
            "format": "int64",
            "x-go-name": "ProjectVersion",
            "description": "Версия сохранённой ревизии; без параметра читается текущая.",
            "name": "projectVersion",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/responses/CostProjectionResponse"
          },
          "400": {
            "description": "Bad Request — не указан ID проекта"
          },
          "404": {
            "description": "Not Found — проект не найден"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
