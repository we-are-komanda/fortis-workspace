            "jamming",
            "spoofing",
            "kinetic",
            "interceptor",
            "passive-protection",
            "engineering-protection",
            "software",
            "command-center",
            "external-service",
            "radiotechnical",
            "radar",
            "electronic-warfare",
            "missile",
            "anti-missile",
